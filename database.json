import json
import os
import time
from datetime import datetime

# Busca o banco de dados na raiz do projeto, subindo um nível a partir da pasta backend
DB_PATH = os.path.join(os.path.dirname(__file__), "../database.json")

def carregar_banco():
    with open(DB_PATH, "r", encoding="utf-8") as f:
        return json.load(f)

def salvar_banco(dados):
    with open(DB_PATH, "w", encoding="utf-8") as f:
        json.dump(dados, f, indent=4, ensure_ascii=False)

def registrar_entrada_pix(conta_id, valor):
    db = carregar_banco()
    if conta_id not in db["contas"]:
        return False
    
    db["contas"][conta_id]["saldo"] += valor
    timestamp_atual = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    
    db["transacoes"].append({
        "transacao_id": f"TX_IN_{int(time.time())}",
        "conta_origem": "BANCO_EXTERNO",
        "conta_destino": conta_id,
        "tipo": "ENTRADA",
        "valor": valor,
        "timestamp": timestamp_atual,
        "status": "CONCLUIDO"
    })
    salvar_banco(db)
    print(f"[CORE] R$ {valor:.2f} depositados na conta {conta_id}.")
    return True

def avaliar_e_processar_saida(conta_origem, conta_destino, valor):
    db = carregar_banco()
    if conta_origem not in db["contas"] or conta_destino not in db["contas"]:
        return "ERRO_CONTA"
    
    conta = db["contas"][conta_origem]
    timestamp_atual = datetime.now()
    
    if conta["saldo"] < valor:
        return "SALDO_INSUFICIENTE"
    
    score_risco = 0
    
    # Regra 1: Idade da Conta
    data_criacao = datetime.strptime(conta["data_criacao"], "%Y-%m-%d")
    if (timestamp_atual - data_criacao).days < 15:
        score_risco += 40
        
    # Regra 2: Estouro do Perfil
    if valor > (conta["limite_historico"] * 5):
        score_risco += 35
        
    # Regra 3: Fator Tempo de Evasão
    ultima_entrada = next((tx for tx in reversed(db["transacoes"]) if tx["conta_destino"] == conta_origem and tx["tipo"] == "ENTRADA"), None)
    if ultima_entrada:
        ts_entrada = datetime.strptime(ultima_entrada["timestamp"], "%Y-%m-%d %H:%M:%S")
        if (timestamp_atual - ts_entrada).total_seconds() < 30:
            score_risco += 45

    tx_id = f"TX_OUT_{int(time.time())}"
    status_final = "CONCLUIDO"
    
    if score_risco >= 70:
        status_final = "RETIDA_PARA_ANALISE"
        conta["saldo"] -= valor 
        print(f"[🚨 ALERTA ANTI-MULE] Transação {tx_id} da conta {conta_origem} RETIDA por suspeita de fraude.")
    else:
        conta["saldo"] -= valor
        db["contas"][conta_destino]["saldo"] += valor
        print(f"[CORE] Transação {tx_id} concluída com sucesso.")

    db["transacoes"].append({
        "transacao_id": tx_id,
        "conta_origem": conta_origem,
        "conta_destino": conta_destino,
        "tipo": "SAIDA",
        "valor": valor,
        "timestamp": timestamp_atual.strftime("%Y-%m-%d %H:%M:%S"),
        "status": status_final,
        "score_risco": score_risco
    })
    
    salvar_banco(db)
    return status_final

if __name__ == "__main__":
    print("=== TESTANDO ENGINE COM BANCO DE DADOS JSON ===")
    registrar_entrada_pix("127001", 15000.0)
    time.sleep(2)
    avaliar_e_processar_saida("127001", "127003", 15000.0)
